# Cross-LLM Audit — API Key
# Copy this file to .env and fill in your API key:
#   cp .env.example .env
#
# .env is git-ignored — your key stays local.
#
# All other settings (provider, model, trigger, language, thresholds, etc.)
# are centralized in .claude/hooks-config.sh — edit them there.
#
# See Docs/CROSS-LLM-AUDIT.md for full setup guide.
# Or run: bash .claude/setup-audit.sh (interactive setup)

# Required — uncomment and fill in to enable cross-LLM audit
# ENABLE_CROSS_AUDIT=true
CROSS_AUDIT_API_KEY=your-api-key-here
