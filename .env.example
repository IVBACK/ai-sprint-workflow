# Cross-LLM Audit — Personal Settings
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is git-ignored — your settings stay local.
# Team defaults are in .claude/hooks-config.sh — values here override them.
#
# See Docs/CROSS-LLM-AUDIT.md for full setup guide.
# Or run: bash .claude/setup-audit.sh (interactive setup)

# ── API Key (required) ──
CROSS_AUDIT_API_KEY=your-api-key-here

# ── Personal Overrides (optional) ──
# Uncomment any line below to override the team default from hooks-config.sh.
#
# CROSS_AUDIT_PROVIDER=openai
# CROSS_AUDIT_API_BASE=https://models.inference.ai.azure.com
# CROSS_AUDIT_MODEL=gpt-4o
# CROSS_AUDIT_LANG=en
# WORKFLOW_MODE=lite
# HOOK_ENTRY_GATE_SESSION=false
