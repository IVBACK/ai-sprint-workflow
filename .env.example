# Cross-LLM Audit Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is git-ignored — your keys stay local.
# See Docs/CROSS-LLM-AUDIT.md for full setup guide.

# Required
ENABLE_CROSS_AUDIT=true
CROSS_AUDIT_API_KEY=your-api-key-here

# Provider: "openai" (default) or "anthropic"
# OpenAI-compatible APIs (GitHub Models, Azure, Ollama, OpenRouter) use "openai"
# CROSS_AUDIT_PROVIDER=openai

# API base URL (auto-set per provider, override for custom endpoints)
# CROSS_AUDIT_API_BASE=https://api.openai.com/v1

# Model name (default: gpt-4o for openai, claude-sonnet-4-20250514 for anthropic)
# CROSS_AUDIT_MODEL=gpt-4o

# Trigger mode: "wave" (every ~5 edits) or "item" (every source edit)
# CROSS_AUDIT_TRIGGER=wave

# Context level: "minimal", "standard", "full"
# CROSS_AUDIT_CONTEXT=standard

# Review language: "en" or "tr"
# CROSS_AUDIT_LANG=en

# Minimum changed lines to trigger audit (default: 10)
# CROSS_AUDIT_MIN_CHANGES=10

# API timeout in seconds (default: 60)
# CROSS_AUDIT_TIMEOUT=60
