# Cross-LLM Audit — Personal Settings
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Or run the interactive setup (recommended):
#   bash .claude/setup-audit.sh
#
# .env is git-ignored — your settings stay local.
# Team defaults are in .claude/hooks-config.sh — values here override them.
#
# See Docs/Workflow/CROSS-LLM-AUDIT.md for full setup guide.

# ── API Key (required) ──
CROSS_AUDIT_API_KEY=

# ── Provider + Model (optional — defaults from hooks-config.sh) ──
# CROSS_AUDIT_PROVIDER=openai
# CROSS_AUDIT_API_BASE=https://api.openai.com/v1
# CROSS_AUDIT_MODEL=gpt-4o
# CROSS_AUDIT_LANG=en

# ── Audit Behavior (optional) ──
# CROSS_AUDIT_ENFORCE_BLOCK=false  # true = BLOCK verdict stops the agent
# CROSS_AUDIT_TIMEOUT=60

# ── Workflow Mode (optional — overrides hooks-config.sh default) ──
# WORKFLOW_MODE=standard
