# ════════════════════════════════════════════════════════════════
# MAIN
# ════════════════════════════════════════════════════════════════
main() {
  # Check for global --lang flag
  local args=() skip_next=false
  for i in $(seq 1 $#); do
    local arg="${!i}"
    if $skip_next; then skip_next=false; continue; fi
    if [[ "$arg" == "--lang" ]]; then
      local next=$((i + 1))
      _LANG="${!next:-en}"
      skip_next=true
      continue
    elif [[ "$arg" == "--lang="* ]]; then
      _LANG="${arg#*=}"
      continue
    fi
    args+=("$arg")
  done

  local cmd="${args[0]:-help}"
  args=("${args[@]:1}")

  case "$cmd" in
    init)        cmd_init "${args[@]}" ;;
    config)      cmd_config "${args[@]}" ;;
    log)         cmd_log "${args[@]}" ;;
    audit-setup) cmd_audit_setup "${args[@]}" ;;
    status)      cmd_status "${args[@]}" ;;
    upgrade)     cmd_upgrade "${args[@]}" ;;
    doctor)      cmd_doctor "${args[@]}" ;;
    completions) cmd_completions "${args[@]}" ;;
    help|--help|-h) cmd_help ;;
    *)
      echo "Unknown command: $cmd"
      cmd_help
      return 1
      ;;
  esac
}

main "$@"
