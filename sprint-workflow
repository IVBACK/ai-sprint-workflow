# ════════════════════════════════════════════════════════════════
# COMMAND: doctor
# ════════════════════════════════════════════════════════════════
cmd_doctor() {
  echo ""
  echo "  $(_bold 'Hook Health Check')"
  echo "  ─────────────────"
  echo ""

  local issues=0

  # Check WORKFLOW.md
  if [[ -f "$_PROJECT_DIR/WORKFLOW.md" ]]; then
    _check "WORKFLOW.md present"
  else
    _fail "WORKFLOW.md missing"
    issues=$((issues + 1))
  fi

  # Check .claude/
  if [[ -d "$_PROJECT_DIR/.claude" ]]; then
    _check ".claude/ directory present"
  else
    _fail ".claude/ directory missing — run 'sprint-workflow init'"
    issues=$((issues + 1))
    echo ""
    echo "  $(_yellow "$issues $(_msg issues_found)")"
    echo ""
    return 1
  fi

  # hooks-config.sh
  if [[ -f "$_PROJECT_DIR/.claude/hooks-config.sh" ]]; then
    local mode
    mode=$(grep '^WORKFLOW_MODE=' "$_PROJECT_DIR/.claude/hooks-config.sh" 2>/dev/null | head -1 | cut -d'"' -f2)
    _check "hooks-config.sh (mode: ${mode:-unknown})"
  else
    _fail "hooks-config.sh missing"
    issues=$((issues + 1))
  fi

  # settings.json
  if [[ -f "$_PROJECT_DIR/.claude/settings.json" ]]; then
    if command -v jq >/dev/null 2>&1 && jq empty "$_PROJECT_DIR/.claude/settings.json" 2>/dev/null; then
      _check "settings.json (valid JSON)"
    else
      _warn "settings.json (exists but may be invalid)"
    fi
  else
    _fail "settings.json missing"
    issues=$((issues + 1))
  fi

  # Hooks
  local hook_dir="$_PROJECT_DIR/.claude/hooks"
  if [[ -d "$hook_dir" ]]; then
    local total=0 executable=0
    for hook in "$hook_dir"/*.sh; do
      [[ ! -f "$hook" ]] && continue
      total=$((total + 1))
      [[ -x "$hook" ]] && executable=$((executable + 1))
    done
    if [[ $executable -eq $total ]]; then
      _check "$total/$total hooks executable"
    else
      _warn "$executable/$total hooks executable — fix: chmod +x .claude/hooks/*.sh"
      issues=$((issues + 1))
    fi
  else
    _fail "hooks/ directory missing"
    issues=$((issues + 1))
  fi

  # Version match
  local hooks_version workflow_version
  hooks_version=$(grep '^HOOKS_VERSION=' "$_PROJECT_DIR/.claude/hooks-config.sh" 2>/dev/null | head -1 | cut -d'"' -f2)
  workflow_version=$(grep 'workflow-version:' "$_PROJECT_DIR/WORKFLOW.md" 2>/dev/null | head -1 | sed 's/.*workflow-version: *//' | sed 's/ *-->.*//')
  if [[ -n "$hooks_version" && -n "$workflow_version" ]]; then
    if [[ "$hooks_version" == "$workflow_version" ]]; then
      _check "Version: hooks=$hooks_version, workflow=$workflow_version"
    else
      _warn "Version mismatch: hooks=$hooks_version, workflow=$workflow_version"
      echo "    Run: sprint-workflow upgrade"
      issues=$((issues + 1))
    fi
  fi

  # Docs/
  local docs_dir="$_PROJECT_DIR/Docs"
  if [[ -d "$docs_dir" ]]; then
    local ref_count=0
    for ref in PARALLEL-EXECUTION.md CROSS-LLM-AUDIT.md WORKFLOW-MODES.md; do
      [[ -f "$docs_dir/$ref" ]] && ref_count=$((ref_count + 1))
    done
    if [[ $ref_count -ge 3 ]]; then
      _check "Docs/ reference guides ($ref_count/3)"
    else
      _warn "Docs/ incomplete ($ref_count/3) — run: sprint-workflow upgrade"
      issues=$((issues + 1))
    fi
  else
    _warn "Docs/ directory missing"
    issues=$((issues + 1))
  fi

  # Audit status
  echo ""
  echo "  $(_bold 'Cross-LLM Audit')"
  echo "  ─────────────────"
  echo ""

  # Cross-audit is enabled by default — check for API key
  local audit_enabled="true"
  if [[ -f "$_PROJECT_DIR/.claude/hooks-config.sh" ]]; then
    audit_enabled=$(bash -c "source '$_PROJECT_DIR/.claude/hooks-config.sh' 2>/dev/null; echo \"\${ENABLE_CROSS_AUDIT:-true}\"")
  fi
  if [[ "$audit_enabled" == "true" ]]; then
    _check "Cross-audit enabled (default)"
    if [[ -f "$_PROJECT_DIR/.env" ]]; then
      local has_key
      has_key=$(grep '^CROSS_AUDIT_API_KEY=' "$_PROJECT_DIR/.env" 2>/dev/null | cut -d= -f2)
      if [[ -n "$has_key" && "$has_key" != "your-api-key-here" && "$has_key" != "no-key-needed" ]]; then
        _check "API key configured"
      elif [[ "$has_key" == "no-key-needed" ]]; then
        _check "Local provider (no key needed)"
      else
        _warn "No API key — cross-audit will silently skip. Run: sprint-workflow audit-setup"
      fi
    else
      _warn "No .env file — cross-audit will silently skip. Run: sprint-workflow audit-setup"
    fi
  else
    _warn "Cross-audit explicitly disabled"
  fi
  # .env gitignore check (if .env exists)
  if [[ -f "$_PROJECT_DIR/.env" ]]; then
    if [[ -f "$_PROJECT_DIR/.gitignore" ]] && grep -q '\.env' "$_PROJECT_DIR/.gitignore" 2>/dev/null; then
      _check ".env is git-ignored"
    else
      _fail ".env exists but NOT in .gitignore — secrets at risk!"
      issues=$((issues + 1))
    fi
  fi

  if [[ "$audit_enabled" == "true" && -f "$_PROJECT_DIR/.claude/hooks/audit-health-check.sh" ]]; then
    echo ""
    bash "$_PROJECT_DIR/.claude/hooks/audit-health-check.sh" 2>/dev/null || true
  fi

  # Remote version check
  _check_upgrade_available 2>/dev/null &
  local upgrade_pid=$!
  # Wait briefly for the check (non-blocking)
  wait "$upgrade_pid" 2>/dev/null || true

  # Summary
  echo ""
  if [[ $issues -eq 0 ]]; then
    echo "  $(_green "$(_msg all_passed)")"
  else
    echo "  $(_yellow "$issues $(_msg issues_found)")"
  fi
  echo ""
}

# ════════════════════════════════════════════════════════════════
# COMMAND: upgrade
# ════════════════════════════════════════════════════════════════

# Escape a string for safe use as sed replacement text
# Handles: \ & | / newlines
_sed_escape() {
  printf '%s' "$1" | sed -e 's/[\\&|/]/\\&/g'
}

# Atomic file write: write to temp, then mv (prevents partial writes)
# Preserves original file permissions when target exists
_atomic_write() {
  local target="$1"
  local content="$2"
  local tmp
  tmp=$(mktemp "${target}.tmp.XXXXXX") || { echo "ERROR: mktemp failed for $target" >&2; return 1; }
  printf '%s' "$content" > "$tmp" || { rm -f "$tmp"; return 1; }
  # Preserve permissions of original file if it exists
  [[ -f "$target" ]] && chmod --reference="$target" "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$target" || { rm -f "$tmp"; return 1; }
}

# Safe sed replacement: escapes value, uses atomic write via temp file
_safe_sed_replace() {
  local file="$1" pattern="$2" replacement="$3"
  local escaped_replacement
  escaped_replacement=$(_sed_escape "$replacement")
  local tmp="${file}.tmp.sed"
  sed "s|${pattern}|${escaped_replacement}|" "$file" > "$tmp" || { rm -f "$tmp"; return 1; }
  mv -f "$tmp" "$file" || { rm -f "$tmp"; return 1; }
}

# Extract all user-set variables from hooks-config.sh
# Returns lines like: WORKFLOW_MODE="lite"
_extract_user_overrides() {
  local config_file="$1"
  [[ ! -f "$config_file" ]] && return

  # Capture all uncommented variable assignments that users can customize:
  #   WORKFLOW_MODE, HOOK_*, ENABLE_*, CROSS_AUDIT_ENFORCE_BLOCK
  grep -E '^(WORKFLOW_MODE|HOOK_|ENABLE_|CROSS_AUDIT_ENFORCE_BLOCK)' "$config_file" 2>/dev/null || true
}

# Apply saved overrides back into the new config file
# Uses atomic writes to prevent partial-restore corruption
_restore_user_overrides() {
  local config_file="$1"
  local overrides_file="$2"
  local restore_summary=""

  [[ ! -f "$overrides_file" ]] && return

  # Work on a temp copy — only replace original when fully done
  local work_copy="${config_file}.restore.tmp"
  cp "$config_file" "$work_copy" || return 1

  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    local var_name="${line%%=*}"
    local var_value="${line#*=}"
    local escaped_value
    escaped_value=$(_sed_escape "$var_value")

    # Check if variable exists in new config (commented or uncommented)
    if grep -qE "^#?\s*${var_name}=" "$work_copy" 2>/dev/null; then
      # Replace the line (uncommented or commented form)
      sed "s|^#*[[:space:]]*${var_name}=.*|${var_name}=${escaped_value}|" "$work_copy" > "${work_copy}.sed" \
        && mv -f "${work_copy}.sed" "$work_copy" \
        || { rm -f "${work_copy}.sed"; }
    else
      # Variable doesn't exist in new template — append before strict enforcement block
      local marker='# ── Strict mode enforcement'
      if grep -qF "$marker" "$work_copy" 2>/dev/null; then
        # Use awk for safe insertion (avoids sed delimiter issues with marker)
        awk -v line="${var_name}=${var_value}" -v mark="$marker" \
          '{if (index($0, mark)) print line; print}' "$work_copy" > "${work_copy}.sed" \
          && mv -f "${work_copy}.sed" "$work_copy" \
          || { rm -f "${work_copy}.sed"; }
      else
        echo "${var_name}=${var_value}" >> "$work_copy"
      fi
    fi
    restore_summary="${restore_summary}    ${var_name}=${var_value}\n"
  done < "$overrides_file"

  # Atomic swap: only replace original after all overrides applied successfully
  mv -f "$work_copy" "$config_file"
  rm -f "${work_copy}.sed" 2>/dev/null

  echo -e "$restore_summary"
}

# Merge settings.json: add new hooks from upstream, keep user's existing hooks
_merge_settings_json() {
  local user_file="$1"
  local upstream_file="$2"

  if [[ ! -f "$user_file" ]]; then
    cp "$upstream_file" "$user_file"
    return 0
  fi

  if ! command -v jq >/dev/null 2>&1; then
    echo "WARN_NO_JQ"
    cp "$upstream_file" "$user_file"
    return 0
  fi

  # Strategy: for each hook event (SessionStart, PreToolUse, PostToolUse),
  # take the upstream hooks as base, then add any user hooks whose command
  # doesn't already exist in upstream.
  local merged
  merged=$(jq -s '
    def merge_hook_group:
      # $base = upstream entries, $user = user entries for same event
      # Keep all upstream, add user entries whose command is not in upstream
      . as [$base, $user] |
      ($base | [.[].hooks[].command]) as $base_cmds |
      $base + [$user[] | select(
        [.hooks[].command] | any(. as $cmd | $base_cmds | index($cmd) | not)
      )];

    .[0] as $upstream | .[1] as $user |
    ($upstream.hooks | keys) as $upstream_events |
    ($user.hooks | keys) as $user_events |
    ($upstream_events + $user_events | unique) as $all_events |

    $upstream | .hooks = (
      [
        $all_events[] | . as $event |
        {
          ($event): (
            if ($upstream.hooks[$event] // null) == null then
              $user.hooks[$event]
            elif ($user.hooks[$event] // null) == null then
              $upstream.hooks[$event]
            else
              [$upstream.hooks[$event], $user.hooks[$event]] | merge_hook_group
            end
          )
        }
      ] | add
    )
  ' "$upstream_file" "$user_file" 2>/dev/null)

  if [[ -n "$merged" && "$merged" != "null" ]]; then
    local tmp_json="${user_file}.tmp.merge"
    echo "$merged" | jq '.' > "$tmp_json" || { rm -f "$tmp_json"; echo "WARN_MERGE_FAIL"; cp "$upstream_file" "$user_file"; return 0; }
    # Preserve permissions and atomic swap
    [[ -f "$user_file" ]] && chmod --reference="$user_file" "$tmp_json" 2>/dev/null || true
    mv -f "$tmp_json" "$user_file" || { rm -f "$tmp_json"; echo "WARN_MERGE_FAIL"; cp "$upstream_file" "$user_file"; return 0; }
    return 0
  else
    # jq merge failed — fall back to overwrite
    echo "WARN_MERGE_FAIL"
    cp "$upstream_file" "$user_file"
    return 0
  fi
}

cmd_upgrade() {
  local auto_yes=false
  [[ "${1:-}" == "--yes" || "${1:-}" == "-y" ]] && auto_yes=true

  echo ""
  echo "  $(_bold 'Upgrade AI Sprint Workflow')"
  echo "  ─────────────────────────"
  echo ""

  local current_version="unknown"
  if [[ -f "$_PROJECT_DIR/.claude/hooks-config.sh" ]]; then
    current_version=$(grep '^HOOKS_VERSION=' "$_PROJECT_DIR/.claude/hooks-config.sh" 2>/dev/null | head -1 | cut -d'"' -f2)
  fi
  echo "  $(_msg current_version) $current_version"

  local temp_dir
  temp_dir=$(mktemp -d)
  echo "  Fetching latest..."
  git clone --depth 1 "$REPO_URL" "$temp_dir" 2>/dev/null || {
    _fail "$(_msg clone_fail)"
    rm -rf "$temp_dir"
    return 1
  }

  local latest_version
  latest_version=$(grep 'workflow-version:' "$temp_dir/WORKFLOW.md" 2>/dev/null | head -1 | sed 's/.*workflow-version: *//' | sed 's/ *-->.*//')
  echo "  $(_msg latest_version)  $latest_version"
  echo ""

  if [[ "$current_version" == "$latest_version" ]]; then
    _check "$(_msg already_up_to_date) (v$current_version)"
    rm -rf "$temp_dir"
    return 0
  fi

  if [[ "$auto_yes" != "true" ]]; then
    read -rp "  $(_msg upgrade_q) $current_version → $latest_version? [Y/n] " confirm
    confirm="${confirm:-Y}"
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
      echo "  $(_msg cancelled)"
      rm -rf "$temp_dir"
      return 0
    fi
  fi

  # ── Track changes for summary ──
  local summary_preserved="" summary_updated="" summary_skipped=""

  # ── Backup hooks-config.sh ──
  local overrides_file=""
  if [[ -f "$_PROJECT_DIR/.claude/hooks-config.sh" ]]; then
    cp "$_PROJECT_DIR/.claude/hooks-config.sh" "$_PROJECT_DIR/.claude/hooks-config.sh.bak"
    _check "$(_msg backed_up) hooks-config.sh"
    # Extract all user overrides before overwriting
    overrides_file=$(mktemp)
    _extract_user_overrides "$_PROJECT_DIR/.claude/hooks-config.sh" > "$overrides_file"
  fi

  # ── Backup settings.json ──
  if [[ -f "$_PROJECT_DIR/.claude/settings.json" ]]; then
    cp "$_PROJECT_DIR/.claude/settings.json" "$_PROJECT_DIR/.claude/settings.json.bak"
    _check "$(_msg backed_up) settings.json"
  fi

  # ── WORKFLOW.md: skip if user modified ──
  local workflow_updated=false
  if [[ -f "$_PROJECT_DIR/WORKFLOW.md" ]]; then
    # Compare local workflow-version tag with current HOOKS_VERSION
    # If they match, user hasn't modified it — safe to overwrite
    local local_wf_version
    local_wf_version=$(grep 'workflow-version:' "$_PROJECT_DIR/WORKFLOW.md" 2>/dev/null | head -1 | sed 's/.*workflow-version: *//' | sed 's/ *-->.*//')
    if [[ "$local_wf_version" == "$current_version" ]]; then
      cp "$temp_dir/WORKFLOW.md" "$_PROJECT_DIR/WORKFLOW.md"
      _check "$(_msg updated) WORKFLOW.md"
      workflow_updated=true
      summary_updated="${summary_updated}    WORKFLOW.md\n"
    else
      _warn "WORKFLOW.md: local modifications detected — skipped"
      echo "    Backup: diff $_PROJECT_DIR/WORKFLOW.md $temp_dir/WORKFLOW.md"
      summary_skipped="${summary_skipped}    WORKFLOW.md (local modifications)\n"
    fi
  else
    cp "$temp_dir/WORKFLOW.md" "$_PROJECT_DIR/WORKFLOW.md"
    _check "$(_msg updated) WORKFLOW.md"
    workflow_updated=true
    summary_updated="${summary_updated}    WORKFLOW.md\n"
  fi

  # ── Hook scripts: always overwrite (framework code) ──
  if [[ -d "$_PROJECT_DIR/.claude/hooks" ]]; then
    cp "$temp_dir"/.claude/hooks/*.sh "$_PROJECT_DIR/.claude/hooks/"
    chmod +x "$_PROJECT_DIR"/.claude/hooks/*.sh
    _check "$(_msg updated) hook scripts"
    summary_updated="${summary_updated}    hook scripts\n"
  fi

  # ── settings.json: merge, not overwrite ──
  if [[ -f "$temp_dir/.claude/settings.json" ]]; then
    local merge_result
    merge_result=$(_merge_settings_json "$_PROJECT_DIR/.claude/settings.json" "$temp_dir/.claude/settings.json")
    if [[ "$merge_result" == "WARN_NO_JQ" ]]; then
      _warn "jq not found — settings.json overwritten (backup: settings.json.bak)"
      summary_updated="${summary_updated}    settings.json (overwritten, no jq)\n"
    elif [[ "$merge_result" == "WARN_MERGE_FAIL" ]]; then
      _warn "settings.json merge failed — overwritten (backup: settings.json.bak)"
      summary_updated="${summary_updated}    settings.json (overwritten, merge failed)\n"
    else
      _check "$(_msg updated) settings.json (merged)"
      summary_updated="${summary_updated}    settings.json (merged)\n"
    fi
  fi

  # ── setup-audit.sh ──
  [[ -f "$temp_dir/.claude/setup-audit.sh" ]] && cp "$temp_dir/.claude/setup-audit.sh" "$_PROJECT_DIR/.claude/setup-audit.sh" && chmod +x "$_PROJECT_DIR/.claude/setup-audit.sh" && _check "$(_msg updated) setup-audit.sh" && summary_updated="${summary_updated}    setup-audit.sh\n"

  # ── Docs/ ──
  if [[ -d "$temp_dir/Docs" ]]; then
    mkdir -p "$_PROJECT_DIR/Docs"
    for ref in PARALLEL-EXECUTION.md CROSS-LLM-AUDIT.md WORKFLOW-MODES.md TEAM-GUIDE.md UNITY-GUIDE.md; do
      [[ -f "$temp_dir/Docs/$ref" ]] && cp "$temp_dir/Docs/$ref" "$_PROJECT_DIR/Docs/$ref"
    done
    _check "$(_msg updated) Docs/"
    summary_updated="${summary_updated}    Docs/\n"
  fi

  # ── Dashboard ──
  [[ -d "$temp_dir/dashboard" ]] && cp -r "$temp_dir/dashboard" "$_PROJECT_DIR/" && chmod +x "$_PROJECT_DIR/dashboard/sprint-status" 2>/dev/null && _check "$(_msg updated) dashboard" && summary_updated="${summary_updated}    dashboard/\n"

  # ── Restore ALL user overrides to new hooks-config.sh ──
  if [[ -n "$overrides_file" && -f "$overrides_file" && -s "$overrides_file" ]]; then
    # Copy new template first
    cp "$temp_dir/.claude/hooks-config.sh" "$_PROJECT_DIR/.claude/hooks-config.sh"
    summary_preserved=$(_restore_user_overrides "$_PROJECT_DIR/.claude/hooks-config.sh" "$overrides_file")
    _check "Restored user overrides to hooks-config.sh"
    rm -f "$overrides_file"
  fi

  # ── Bump HOOKS_VERSION (always takes precedence) ──
  if [[ -n "$latest_version" && -f "$_PROJECT_DIR/.claude/hooks-config.sh" ]]; then
    _safe_sed_replace "$_PROJECT_DIR/.claude/hooks-config.sh" "^HOOKS_VERSION=.*" "HOOKS_VERSION=\"$latest_version\""
    _check "$(_msg bumped) HOOKS_VERSION → $latest_version"
  fi

  rm -rf "$temp_dir"

  # ── Upgrade Summary ──
  echo ""
  echo "  $(_bold 'Upgrade Summary') ($current_version → $latest_version)"
  echo "  ───────────────"
  if [[ -n "$summary_updated" ]]; then
    echo "  Updated:"
    echo -e "$summary_updated"
  fi
  if [[ -n "$summary_preserved" ]]; then
    echo "  Preserved user overrides:"
    echo -e "$summary_preserved"
  fi
  if [[ -n "$summary_skipped" ]]; then
    echo "  Skipped:"
    echo -e "$summary_skipped"
  fi
  echo "  Backups: hooks-config.sh.bak, settings.json.bak"
  echo ""
  _check "$(_msg upgrade_complete) $current_version → $latest_version"
  echo ""
}

# ════════════════════════════════════════════════════════════════
# COMMAND: completions
# ════════════════════════════════════════════════════════════════
cmd_completions() {
  local shell="${1:-bash}"

  case "$shell" in
    bash)
      cat <<'BASH_COMP'
# Add to ~/.bashrc:
# eval "$(sprint-workflow completions bash)"
_sprint_workflow() {
  local cur="${COMP_WORDS[COMP_CWORD]}"
  local prev="${COMP_WORDS[COMP_CWORD-1]}"
  local cmds="init config log audit-setup status upgrade doctor completions help"

  case "$prev" in
    sprint-workflow)
      COMPREPLY=( $(compgen -W "$cmds" -- "$cur") )
      ;;
    init)
      COMPREPLY=( $(compgen -W "--auto --agent --mode --no-audit --lang" -- "$cur") )
      ;;
    config)
      COMPREPLY=( $(compgen -W "mode audit.wave-size audit.min-changes audit.timeout audit.context audit.trigger audit.lang audit.model audit.provider hook.protect-claude hook.protect-secrets hook.validate-tracking hook.session-start" -- "$cur") )
      ;;
    --agent)
      COMPREPLY=( $(compgen -W "claude-code cursor copilot windsurf cline codex gemini other" -- "$cur") )
      ;;
    --mode)
      COMPREPLY=( $(compgen -W "freestyle lite standard strict" -- "$cur") )
      ;;
    --lang)
      COMPREPLY=( $(compgen -W "en tr" -- "$cur") )
      ;;
    log)
      COMPREPLY=( $(compgen -W "--all --errors --success -n" -- "$cur") )
      ;;
    upgrade)
      COMPREPLY=( $(compgen -W "--yes" -- "$cur") )
      ;;
    completions)
      COMPREPLY=( $(compgen -W "bash zsh fish" -- "$cur") )
      ;;
  esac
}
complete -F _sprint_workflow sprint-workflow
BASH_COMP
      ;;
    zsh)
      cat <<'ZSH_COMP'
# Add to ~/.zshrc:
# eval "$(sprint-workflow completions zsh)"
_sprint_workflow() {
  local -a commands=(
    'init:Install files + interactive onboarding + launch bootstrap'
    'config:View or set configuration values'
    'log:View cross-LLM audit log'
    'audit-setup:Configure cross-LLM audit'
    'status:Sprint dashboard'
    'upgrade:Update workflow to latest version'
    'doctor:Health check'
    'completions:Generate shell completions'
    'help:Show help'
  )

  _arguments '1: :->cmd' '*: :->args'

  case $state in
    cmd) _describe 'command' commands ;;
    args)
      case $words[2] in
        init)    _values 'flags' '--auto' '--agent' '--mode' '--no-audit' '--lang' ;;
        config)  _values 'keys' 'mode' 'audit.wave-size' 'audit.min-changes' 'audit.timeout' 'audit.context' 'audit.trigger' 'audit.lang' 'audit.model' 'audit.provider' ;;
        log)     _values 'flags' '--all' '--errors' '--success' '-n' ;;
        upgrade) _values 'flags' '--yes' ;;
        completions) _values 'shell' 'bash' 'zsh' 'fish' ;;
        --agent) _values 'agents' 'claude-code' 'cursor' 'copilot' 'windsurf' 'cline' 'codex' 'gemini' 'other' ;;
        --mode)  _values 'modes' 'freestyle' 'lite' 'standard' 'strict' ;;
        --lang)  _values 'langs' 'en' 'tr' ;;
      esac ;;
  esac
}
compdef _sprint_workflow sprint-workflow
ZSH_COMP
      ;;
    fish)
      cat <<'FISH_COMP'
# Add to ~/.config/fish/completions/sprint-workflow.fish
complete -c sprint-workflow -n '__fish_use_subcommand' -a 'init' -d 'Install + onboarding + bootstrap'
complete -c sprint-workflow -n '__fish_use_subcommand' -a 'config' -d 'View/set configuration'
complete -c sprint-workflow -n '__fish_use_subcommand' -a 'log' -d 'View audit log'
complete -c sprint-workflow -n '__fish_use_subcommand' -a 'audit-setup' -d 'Configure cross-LLM audit'
complete -c sprint-workflow -n '__fish_use_subcommand' -a 'status' -d 'Sprint dashboard'
complete -c sprint-workflow -n '__fish_use_subcommand' -a 'upgrade' -d 'Update to latest version'
complete -c sprint-workflow -n '__fish_use_subcommand' -a 'doctor' -d 'Health check'
complete -c sprint-workflow -n '__fish_use_subcommand' -a 'completions' -d 'Generate shell completions'
complete -c sprint-workflow -n '__fish_use_subcommand' -a 'help' -d 'Show help'
complete -c sprint-workflow -n '__fish_seen_subcommand_from init' -l auto -d 'Non-interactive mode'
complete -c sprint-workflow -n '__fish_seen_subcommand_from init' -l agent -xa 'claude-code cursor copilot windsurf cline codex gemini other'
complete -c sprint-workflow -n '__fish_seen_subcommand_from init' -l mode -xa 'freestyle lite standard strict'
complete -c sprint-workflow -n '__fish_seen_subcommand_from init' -l no-audit -d 'Skip audit setup'
complete -c sprint-workflow -n '__fish_seen_subcommand_from init' -l lang -xa 'en tr'
complete -c sprint-workflow -n '__fish_seen_subcommand_from log' -l all -d 'Show all entries'
complete -c sprint-workflow -n '__fish_seen_subcommand_from log' -l errors -d 'Show errors only'
complete -c sprint-workflow -n '__fish_seen_subcommand_from log' -l success -d 'Show successes only'
complete -c sprint-workflow -n '__fish_seen_subcommand_from upgrade' -l yes -d 'Skip confirmation'
complete -c sprint-workflow -n '__fish_seen_subcommand_from completions' -xa 'bash zsh fish'
FISH_COMP
      ;;
    *)
      echo "Unsupported shell: $shell (use: bash, zsh, fish)"
      return 1
      ;;
  esac
}

