_msg() {
  local key="$1"
  if [[ "$_LANG" == "tr" ]]; then
    echo "${_MSG_TR[$key]:-${_MSG_EN[$key]:-$key}}"
  else
    echo "${_MSG_EN[$key]:-$key}"
  fi
}

# ── Colors ──
_bold()   { printf '\033[1m%s\033[0m' "$1"; }
_green()  { printf '\033[32m%s\033[0m' "$1"; }
_yellow() { printf '\033[33m%s\033[0m' "$1"; }
_red()    { printf '\033[31m%s\033[0m' "$1"; }
_dim()    { printf '\033[2m%s\033[0m' "$1"; }
_check()  { printf '  \033[32m✓\033[0m %s\n' "$1"; }
_warn()   { printf '  \033[33m!\033[0m %s\n' "$1"; }
_fail()   { printf '  \033[31m✗\033[0m %s\n' "$1"; }
_step()   { printf '\n  \033[1m[%s]\033[0m %s\n' "$1" "$2"; }

# Copy text to clipboard (cross-platform, best-effort)
_copy_to_clipboard() {
  local text="$1"
  if command -v pbcopy >/dev/null 2>&1; then
    printf '%s' "$text" | pbcopy && return 0
  elif command -v wl-copy >/dev/null 2>&1; then
    printf '%s' "$text" | wl-copy && return 0
  elif command -v xclip >/dev/null 2>&1; then
    printf '%s' "$text" | xclip -selection clipboard && return 0
  elif command -v xsel >/dev/null 2>&1; then
    printf '%s' "$text" | xsel --clipboard --input && return 0
  fi
  return 1
}

# Ask user if they want to copy prompt to clipboard, then do it
_offer_clipboard() {
  local text="$1"
  local copy_choice
  echo ""
  read -rp "    $(_msg copy_clipboard_q) [Y/n] " copy_choice
  copy_choice="${copy_choice:-Y}"
  if [[ "$copy_choice" =~ ^[Yy]$ ]]; then
    if _copy_to_clipboard "$text"; then
      _check "$(_msg copied_clipboard)"
    else
      _warn "$(_msg clipboard_failed)"
      echo "      \"$text\""
    fi
  fi
  echo ""
}

# ── Determine context ──
_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
_PROJECT_DIR="$(pwd)"

# ── Version check helper (used by doctor + status) ──
_check_upgrade_available() {
  # Quick version check via raw GitHub (no clone, fast)
  local remote_version
  remote_version=$(curl -sfL --max-time 5 "$RAW_URL/WORKFLOW.md" 2>/dev/null | grep 'workflow-version:' | head -1 | sed 's/.*workflow-version: *//' | sed 's/ *-->.*//')
  local local_version
  local_version=$(grep '^HOOKS_VERSION=' "$_PROJECT_DIR/.claude/hooks-config.sh" 2>/dev/null | head -1 | cut -d'"' -f2)

  if [[ -n "$remote_version" && -n "$local_version" && "$remote_version" != "$local_version" ]]; then
    echo ""
    _warn "$(_msg new_version_available): $local_version → $remote_version"
    echo "    $(_msg run_upgrade)"
  fi
}

# ════════════════════════════════════════════════════════════════
# COMMAND: init
# ════════════════════════════════════════════════════════════════
cmd_init() {
  # ── Parse flags ──
  local auto=false opt_agent="" opt_mode="" opt_no_audit=false opt_lang=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --auto)     auto=true ;;
      --agent)    opt_agent="$2"; shift ;;
      --agent=*)  opt_agent="${1#*=}" ;;
      --mode)     opt_mode="$2"; shift ;;
      --mode=*)   opt_mode="${1#*=}" ;;
      --no-audit) opt_no_audit=true ;;
      --lang)     opt_lang="$2"; shift ;;
      --lang=*)   opt_lang="${1#*=}" ;;
      *) ;;
    esac
    shift
  done
  [[ -n "$opt_lang" ]] && _LANG="$opt_lang"

  echo ""
  echo "  $(_bold "$(_msg setup_title)")"
  echo "  ─────────────────────────"

  # ── Step 1: Install files ──
  _step "1/5" "$(_msg step_install)"

  local src_dir="$_SCRIPT_DIR"
  local temp_clone=""

  if [[ ! -f "$src_dir/WORKFLOW.md" ]]; then
    echo "    $(_msg cloning)"
    temp_clone=$(mktemp -d)
    git clone --depth 1 "$REPO_URL" "$temp_clone" 2>/dev/null || {
      _fail "$(_msg clone_fail)"
      return 1
    }
    src_dir="$temp_clone"
  fi

  if [[ -f "$_PROJECT_DIR/sprint-workflow" && -d "$_PROJECT_DIR/validation" && -d "$_PROJECT_DIR/examples" ]]; then
    _fail "$(_msg inside_repo)"
    echo "    $(_msg cd_first)"
    [[ -n "$temp_clone" ]] && rm -rf "$temp_clone"
    return 1
  fi

  local -a EXCLUDE=(.git .github validation examples checks Tools
    README.md DESIGN.md CONTRIBUTING.md LICENSE
    sprint-audit-template.sh ROADMAP-DESIGN-PROMPT.md .gitignore sprint-workflow)

  local copied=0 skipped=0
  for item in "$src_dir"/* "$src_dir"/.[!.]* "$src_dir"/..?*; do
    [[ ! -e "$item" ]] && continue
    local base
    base="$(basename "$item")"

    local skip=false
    for exc in "${EXCLUDE[@]}"; do
      [[ "$base" == "$exc" ]] && skip=true && break
    done
    $skip && continue

    if [[ -d "$item" ]]; then
      if [[ -d "$_PROJECT_DIR/$base" ]]; then
        cp -rn "$item" "$_PROJECT_DIR/" 2>/dev/null || \
        cp -r --no-clobber "$item" "$_PROJECT_DIR/" 2>/dev/null || \
        { command -v rsync >/dev/null 2>&1 && rsync -a --ignore-existing "$item/" "$_PROJECT_DIR/$base/"; } || \
        cp -r "$item" "$_PROJECT_DIR/"
        _check "$base/ ($(_msg merged))"
      else
        cp -r "$item" "$_PROJECT_DIR/"
        _check "$base/"
      fi
      copied=$((copied + 1))
    else
      if [[ -f "$_PROJECT_DIR/$base" ]]; then
        _warn "$base ($(_msg exists))"
        skipped=$((skipped + 1))
      else
        cp "$item" "$_PROJECT_DIR/"
        _check "$base"
        copied=$((copied + 1))
      fi
    fi
  done

  [[ -n "$temp_clone" ]] && rm -rf "$temp_clone"
  echo "    $copied $(_msg copied), $skipped $(_msg skipped)"
  chmod +x "$_PROJECT_DIR"/.claude/hooks/*.sh "$_PROJECT_DIR"/.claude/setup-audit.sh 2>/dev/null || true

  # ── Step 2: Select AI agent ──
  local agent_name="claude-code" has_hooks=true

  if [[ -n "$opt_agent" ]]; then
    agent_name="$opt_agent"
    _step "2/5" "$(_msg step_agent)"
    _check "$agent_name (--agent)"
  elif [[ "$auto" == "true" ]]; then
    _step "2/5" "$(_msg step_agent)"
    _check "claude-code (auto)"
  else
    _step "2/5" "$(_msg step_agent)"
    echo ""
    echo "    1) Claude Code   (full hooks + cross-LLM audit)"
    echo "    2) Cursor"
    echo "    3) GitHub Copilot"
    echo "    4) Windsurf"
    echo "    5) Cline"
    echo "    6) Codex CLI"
    echo "    7) Gemini CLI"
    echo "    8) Other"
    echo ""
    local agent_choice
    read -rp "    → " agent_choice
    agent_choice="${agent_choice:-1}"
    case "$agent_choice" in
      1) agent_name="claude-code" ;;
      2) agent_name="cursor" ;;
      3) agent_name="copilot" ;;
      4) agent_name="windsurf" ;;
      5) agent_name="cline" ;;
      6) agent_name="codex" ;;
      7) agent_name="gemini" ;;
      *) agent_name="other" ;;
    esac
  fi

  case "$agent_name" in
    claude-code) has_hooks=true ;;
    *) has_hooks=false ;;
  esac

  if [[ "$has_hooks" == "false" ]]; then
    _warn "$(_msg hooks_inactive) $agent_name."
    echo "    $(_msg workflow_via_md)"
  fi

  # ── Step 3: Workflow mode ──
  local mode="standard"
  if [[ -n "$opt_mode" ]]; then
    mode="$opt_mode"
    _step "3/5" "$(_msg step_mode)"
    _check "WORKFLOW_MODE=$mode (--mode)"
  elif [[ "$auto" == "true" ]]; then
    _step "3/5" "$(_msg step_mode)"
    _check "WORKFLOW_MODE=standard (auto)"
  else
    _step "3/5" "$(_msg step_mode)"
    echo ""
    echo "    1) $(_msg mode_freestyle)"
    echo "    2) $(_msg mode_lite)"
    echo "    3) $(_msg mode_standard)"
    echo "    4) $(_msg mode_strict)"
    echo ""
    local mode_choice
    read -rp "    → [3] " mode_choice
    mode_choice="${mode_choice:-3}"
    case "$mode_choice" in
      1) mode="freestyle" ;; 2) mode="lite" ;; 4) mode="strict" ;; *) mode="standard" ;;
    esac
  fi

  if [[ "$has_hooks" == "true" && -f "$_PROJECT_DIR/.claude/hooks-config.sh" ]]; then
    _safe_sed_replace "$_PROJECT_DIR/.claude/hooks-config.sh" "^WORKFLOW_MODE=.*" "WORKFLOW_MODE=\"$mode\""
    # Only print confirmation if not already printed by --mode or --auto
    [[ -z "$opt_mode" && "$auto" != "true" ]] && _check "WORKFLOW_MODE=$mode"
  else
    _check "$mode"
    echo "    $(_msg mode_tell_ai) \"Use $(_bold "$mode") mode.\""
  fi

  # ── Step 4: Cross-LLM Audit ──
  if [[ "$has_hooks" == "true" ]]; then
    _step "4/5" "$(_msg step_audit)"
    if [[ "$opt_no_audit" == "true" || "$auto" == "true" ]]; then
      _warn "$(_msg audit_skipped)"
    else
      echo ""
      echo "    $(_msg audit_desc1)"
      echo "    $(_msg audit_desc2)"
      echo ""
      echo "    $(_msg audit_providers)"
      echo ""
      local audit_choice
      read -rp "    $(_msg audit_enable) [y/N] " audit_choice
      if [[ "$audit_choice" =~ ^[Yy]$ ]]; then
        [[ -f "$_PROJECT_DIR/.claude/setup-audit.sh" ]] && CALLED_FROM_INIT=1 bash "$_PROJECT_DIR/.claude/setup-audit.sh" || \
          _fail "setup-audit.sh not found."
      else
        _warn "$(_msg audit_skipped)"
      fi
    fi
  else
    _step "4/5" "$(_msg step_audit)"
    _warn "$(_msg audit_requires_hooks) $agent_name."
  fi

  # ── Launch helper: sends a prompt to the AI via CLI or editor ──
  # Usage: _launch_ai "prompt text" [--no-done]
  #   --no-done: don't print "Done" section (used when chaining roadmap → bootstrap)
  _launch_ai() {
    local prompt="$1" show_done=true
    [[ "${2:-}" == "--no-done" ]] && show_done=false

    # Determine available CLI and editor commands for this agent
    local cli_cmd="" editor_cmd=""
    case "$agent_name" in
      claude-code) cli_cmd="claude" ;;
      cursor)      editor_cmd="cursor ."; cli_cmd="cursor" ;;
      windsurf)    editor_cmd="windsurf ."; cli_cmd="windsurf" ;;
      codex)       cli_cmd="codex" ;;
      gemini)      cli_cmd="gemini" ;;
      copilot|cline|*) ;;
    esac

    # Detect what's available
    local has_cli=false has_editor=false
    if [[ -n "$cli_cmd" ]] && command -v "$cli_cmd" >/dev/null 2>&1; then
      has_cli=true
    fi
    if [[ -n "$editor_cmd" ]]; then
      local editor_bin
      editor_bin="$(echo "$editor_cmd" | cut -d' ' -f1)"
      command -v "$editor_bin" >/dev/null 2>&1 && has_editor=true
    fi

    # Auto mode: try CLI, fall back to clipboard
    if [[ "$auto" == "true" ]]; then
      if $has_cli; then
        echo ""
        echo "  ─────────────────────────"
        echo "  $(_msg launching) $cli_cmd..."
        echo "  ─────────────────────────"
        echo ""
        exec "$cli_cmd" "$prompt"
      else
        _offer_clipboard "$prompt"
        echo "    $(_msg open_editor)"
        echo "      \"$prompt\""
      fi
      return
    fi

    # Interactive: CLI vs Editor
    echo ""
    if $has_cli && $has_editor; then
      echo "      1) $(_msg launch_opt_cli)  ($cli_cmd)"
      echo "      2) $(_msg launch_opt_editor)  ($editor_cmd)"
      echo ""
      local lc
      read -rp "    [1-2] " lc
      if [[ "${lc:-1}" == "2" ]]; then
        _offer_clipboard "$prompt"
        echo "    $(_msg opening) $agent_name..."
        $editor_cmd &
      else
        echo ""
        echo "  ─────────────────────────"
        echo "  $(_msg launching) $cli_cmd..."
        echo "  ─────────────────────────"
        echo ""
        exec "$cli_cmd" "$prompt"
      fi
    elif $has_cli; then
      echo "      1) $(_msg launch_opt_cli)  ($cli_cmd)"
      echo "      2) $(_msg launch_opt_editor)"
      echo ""
      local lc
      read -rp "    [1-2] " lc
      if [[ "${lc:-1}" == "2" ]]; then
        _offer_clipboard "$prompt"
        echo "    $(_msg open_editor)"
        echo "      \"$prompt\""
      else
        echo ""
        echo "  ─────────────────────────"
        echo "  $(_msg launching) $cli_cmd..."
        echo "  ─────────────────────────"
        echo ""
        exec "$cli_cmd" "$prompt"
      fi
    elif $has_editor; then
      _offer_clipboard "$prompt"
      echo "    $(_msg opening) $agent_name..."
      $editor_cmd &
    else
      _offer_clipboard "$prompt"
      echo "    $(_msg open_editor)"
      echo "      \"$prompt\""
    fi
  }

  # ── Step 5: Launch ──
  _step "5/5" "$(_msg step_launch)"

  local bootstrap_prompt="Read WORKFLOW.md and bootstrap this project."
  local roadmap_prompt="$(_msg roadmap_prompt)"

  # Ask about roadmap design (skip in auto mode)
  if [[ "$auto" != "true" ]]; then
    echo ""
    echo "    $(_msg roadmap_q)"
    echo "    $(_dim "$(_msg roadmap_desc)")"
    echo ""
    local roadmap_choice
    read -rp "    [y/N] " roadmap_choice
    if [[ "$roadmap_choice" =~ ^[Yy]$ ]]; then
      echo ""
      echo "    $(_msg launch_how)"
      _launch_ai "$roadmap_prompt" --no-done
      # If we get here, AI session ended (editor flow) — ask to continue to bootstrap
      echo ""
      echo "  ─────────────────────────"
      echo "    $(_msg bootstrap_ready)"
      echo ""
      local bs_choice
      read -rp "    [Y/n] " bs_choice
      if [[ ! "${bs_choice:-Y}" =~ ^[Nn]$ ]]; then
        echo ""
        echo "    $(_msg launch_how)"
        _launch_ai "$bootstrap_prompt"
      fi
    else
      _dim "    $(_msg roadmap_skip)"
      echo ""
      echo ""
      echo "    $(_msg launch_how)"
      _launch_ai "$bootstrap_prompt"
    fi
  else
    _launch_ai "$bootstrap_prompt"
  fi

  # ── Done ──
  echo ""
  echo "  ─────────────────────────"
  _check "$(_msg setup_complete)"
  echo ""
  echo "    $(_msg useful_cmds)"
  echo "      sprint-workflow status    — sprint dashboard"
  echo "      sprint-workflow doctor    — hook health check"
  echo "      sprint-workflow upgrade   — update workflow"
  echo ""
}

# ════════════════════════════════════════════════════════════════
# COMMAND: config
# ════════════════════════════════════════════════════════════════
cmd_config() {
  local key="${1:-}" value="${2:-}"
  local config_file="$_PROJECT_DIR/.claude/hooks-config.sh"
  local env_file="$_PROJECT_DIR/.env"

  if [[ ! -f "$config_file" ]]; then
    _fail "hooks-config.sh not found. Run 'sprint-workflow init' first."
    return 1
  fi

  # No args: show current config
  if [[ -z "$key" ]]; then
    echo ""
    echo "  $(_bold 'Current Configuration')"
    echo "  ─────────────────────"
    echo ""

    # Core settings
    local mode hooks_ver
    mode=$(grep '^WORKFLOW_MODE=' "$config_file" 2>/dev/null | head -1 | cut -d'"' -f2)
    hooks_ver=$(grep '^HOOKS_VERSION=' "$config_file" 2>/dev/null | head -1 | cut -d'"' -f2)
    echo "  $(_bold 'Core')"
    echo "    WORKFLOW_MODE    = ${mode:-standard}"
    echo "    HOOKS_VERSION    = ${hooks_ver:-unknown}"

    # Hook flags
    echo ""
    echo "  $(_bold 'Hooks') (from hooks-config.sh)"
    grep '^HOOK_' "$config_file" 2>/dev/null | while IFS= read -r line; do
      local hk hv
      hk=$(echo "$line" | cut -d= -f1)
      hv=$(echo "$line" | cut -d= -f2 | tr -d '"')
      if [[ "$hv" == "true" ]]; then
        printf '    %-35s %s\n' "$hk" "$(_green "on")"
      else
        printf '    %-35s %s\n' "$hk" "$(_dim "off")"
      fi
    done

    # Audit settings
    echo ""
    echo "  $(_bold 'Cross-LLM Audit')"
    local has_key="false"
    if [[ -f "$_PROJECT_DIR/.env" ]]; then
      local key_val
      key_val=$(grep '^CROSS_AUDIT_API_KEY=' "$_PROJECT_DIR/.env" 2>/dev/null | cut -d= -f2)
      [[ -n "$key_val" && "$key_val" != "your-api-key-here" ]] && has_key="true"
    fi
    # Source hooks-config to get ENABLE_CROSS_AUDIT value
    local audit_enabled="true"
    if [[ -f "$_PROJECT_DIR/.claude/hooks-config.sh" ]]; then
      audit_enabled=$(bash -c "source '$_PROJECT_DIR/.claude/hooks-config.sh' 2>/dev/null; echo \"\${ENABLE_CROSS_AUDIT:-true}\"")
    fi
    if [[ "$audit_enabled" == "true" && "$has_key" == "true" ]]; then
      echo "    Status: ACTIVE (enabled + API key set)"
    elif [[ "$audit_enabled" == "true" && "$has_key" == "false" ]]; then
      echo "    Status: ENABLED but no API key — run: bash .claude/setup-audit.sh"
    else
      echo "    Status: DISABLED (ENABLE_CROSS_AUDIT=false)"
    fi
    if [[ -f "$env_file" ]]; then
      grep '^CROSS_AUDIT_' "$env_file" 2>/dev/null | grep -v 'API_KEY' | while IFS= read -r line; do
        local ck cv
        ck=$(echo "$line" | cut -d= -f1)
        cv=$(echo "$line" | cut -d= -f2)
        printf '    %-35s %s\n' "$ck" "$cv"
      done
    fi

    echo ""
    echo "  $(_dim "Set: sprint-workflow config KEY VALUE")"
    echo "  $(_dim "Example: sprint-workflow config mode lite")"
    echo ""
    return 0
  fi

  # Single arg: get value
  if [[ -z "$value" ]]; then
    case "$key" in
      mode)
        grep '^WORKFLOW_MODE=' "$config_file" | head -1 | cut -d'"' -f2
        ;;
      audit.*)
        local audit_key="${key#audit.}"
        local env_key="CROSS_AUDIT_$(echo "$audit_key" | tr '[:lower:]-' '[:upper:]_')"
        grep "^$env_key=" "$env_file" 2>/dev/null | head -1 | cut -d= -f2 || \
        echo "(not set)"
        ;;
      hook.*)
        local hook_key="HOOK_$(echo "${key#hook.}" | tr '[:lower:]-' '[:upper:]_')"
        grep "^$hook_key=" "$config_file" 2>/dev/null | head -1 | cut -d= -f2 | tr -d '"' || echo "(not set)"
        ;;
      *)
        grep "^$key=" "$config_file" 2>/dev/null | head -1 | cut -d= -f2 | tr -d '"' || echo "(not set)"
        ;;
    esac
    return 0
  fi

  # Two args: set value
  case "$key" in
    mode)
      if [[ "$value" =~ ^(freestyle|lite|standard|strict)$ ]]; then
        _safe_sed_replace "$config_file" "^WORKFLOW_MODE=.*" "WORKFLOW_MODE=\"$value\""
        _check "WORKFLOW_MODE=$value"
      else
        _fail "Invalid mode: $value (use: freestyle, lite, standard, strict)"
        return 1
      fi
      ;;
    audit.wave-size|audit.min-changes|audit.timeout|audit.context|audit.trigger|audit.lang|audit.model|audit.provider|audit.api-base|audit.dual-review|audit.autofix-limit|audit.autofix-log|audit.close-gate-autofix)
      local audit_key="${key#audit.}"
      local env_key="CROSS_AUDIT_$(echo "$audit_key" | tr '[:lower:]-' '[:upper:]_')"
      touch "$env_file"
      if grep -q "^$env_key=" "$env_file" 2>/dev/null; then
        _safe_sed_replace "$env_file" "^${env_key}=.*" "${env_key}=${value}"
      else
        echo "$env_key=$value" >> "$env_file"
      fi
      _check "$env_key=$value (in .env)"
      ;;
    hook.*)
      local hook_key="HOOK_$(echo "${key#hook.}" | tr '[:lower:]-' '[:upper:]_')"
      if grep -q "^$hook_key=" "$config_file" 2>/dev/null; then
        _safe_sed_replace "$config_file" "^${hook_key}=.*" "${hook_key}=${value}"
      else
        echo "$hook_key=$value" >> "$config_file"
      fi
      _check "$hook_key=$value"
      ;;
    *)
      _fail "Unknown config key: $key"
      echo "  Available: mode, audit.*, hook.*"
      return 1
      ;;
  esac
}

# ════════════════════════════════════════════════════════════════
# COMMAND: log
# ════════════════════════════════════════════════════════════════
cmd_log() {
  local filter="all" count=10
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all)     filter="all"; count=0 ;;
      --errors)  filter="errors" ;;
      --success) filter="success" ;;
      -n)        count="$2"; shift ;;
      -n*)       count="${1#-n}" ;;
      *) ;;
    esac
    shift
  done

  local log_file="$_PROJECT_DIR/.claude/.state/cross-audit-log.jsonl"

  if [[ ! -f "$log_file" ]]; then
    _warn "$(_msg no_audit_log)"
    echo "  Path: $log_file"
    return 1
  fi

  if ! command -v jq >/dev/null 2>&1; then
    # Fallback without jq
    echo ""
    echo "  $(_bold "$(_msg last_entries)")"
    if [[ $count -eq 0 ]]; then
      cat "$log_file"
    else
      tail -n "$count" "$log_file"
    fi
    return 0
  fi

  # Stats
  local total success_count error_count skip_count
  total=$(wc -l < "$log_file" | tr -d ' ')
  success_count=$(grep -c '"success"' "$log_file" 2>/dev/null || echo 0)
  error_count=$(grep -c '"error"' "$log_file" 2>/dev/null || echo 0)
  skip_count=$(grep -c '"skip"' "$log_file" 2>/dev/null || echo 0)

  echo ""
  echo "  $(_bold 'Cross-LLM Audit Log')"
  echo "  ─────────────────────"
  echo ""
  echo "  $(_msg total_entries) $total  ($(_green "$success_count success"), $(_red "$error_count errors"), $(_dim "$skip_count skips"))"
  echo ""

  # Filter and display
  local jq_filter='.'
  local label="$(_msg last_entries)"
  case "$filter" in
    errors)
      jq_filter='select(.status == "error")'
      label="$(_msg errors_only)"
      ;;
    success)
      jq_filter='select(.status == "success")'
      label="$(_msg success_only)"
      ;;
  esac

  echo "  $(_bold "$label")"
  echo ""

  local data
  if [[ $count -eq 0 ]]; then
    data=$(jq -c "$jq_filter" "$log_file" 2>/dev/null)
  else
    data=$(jq -c "$jq_filter" "$log_file" 2>/dev/null | tail -n "$count")
  fi

  if [[ -z "$data" ]]; then
    echo "  (no matching entries)"
  else
    echo "$data" | jq -r '
      "\(.ts)  [\(.status | if . == "success" then "\u001b[32m\(.)\u001b[0m"
        elif . == "error" then "\u001b[31m\(.)\u001b[0m"
        else "\u001b[2m\(.)\u001b[0m" end)]  \(
        if .status == "success" then "verdict=\(.verdict) mode=\(.mode)"
        elif .status == "skip" then .reason
        else .reason end)  \(.file // "" | split("/") | last)"
    ' 2>/dev/null || echo "$data"
  fi
  echo ""
}

